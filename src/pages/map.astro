---
import Base from '../layouts/Base.astro';
import MapView from '../islands/MapView.tsx';
import { PROGRAMS } from '../data/programs';
---

<Base
  title="Orbital · Map of founder residencies & hacker houses"
  description="Orbital maps the residencies, hacker houses and co-living programs where founders move in and build together. Find your people, anywhere in the world."
  fullscreen
>
  <!-- Leaflet needs the DOM; render this island client-only. -->
  <MapView programs={PROGRAMS} client:only="react" />
  <div slot="head"></div>
</Base>
