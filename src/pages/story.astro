---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.tsx';
import OrbitalLogo from '../components/OrbitalLogo.astro';
import { PROGRAMS, FACETS } from '../data/programs';

const countryCount = Object.keys(FACETS.country).length;
---

<Base
  title="0rbital story · live-in founder communities"
  description="0rbital (Orbital) is a story-focused guide to live-in founder residencies, hacker houses, and co-living programs where builders gather momentum for their next launch."
>
  <header class="mx-auto max-w-[1100px] px-7 pt-5">
    <SiteNav current="story" client:load />
  </header>

  <main>
    <section class="mx-auto max-w-[1100px] px-7 pb-8 pt-12">
      <div class="mb-2 inline-flex items-center gap-2 font-display text-[11px] font-semibold uppercase tracking-[.22em] text-a2">
        <OrbitalLogo variant="mark" class="h-5 w-5 flex-none" />
        0rbital story
      </div>
      <h1 class="m-0 mb-4 max-w-[760px] font-display text-[34px] font-bold leading-[1.06] text-text sm:text-[46px]">
        Find your orbit. Launch what’s next.
      </h1>
      <p class="m-0 max-w-[720px] text-[16px] leading-relaxed text-muted">
        The right environment changes your trajectory. 0rbital maps live-in founder residencies,
        hacker houses, and co-living programs where builders leave home for a season, share space
        with serious peers, and gather momentum for the work ahead.
      </p>
    </section>

    <div class="mx-auto max-w-[1100px] px-7"><hr class="orbit-divider" /></div>

    <section class="mx-auto grid max-w-[1100px] gap-7 px-7 py-9 md:grid-cols-[1.05fr_.95fr] md:gap-10">
      <div>
        <h2 class="m-0 mb-3 flex items-center gap-2 font-display text-[19px] font-bold text-text">
          <span class="orbit-node" aria-hidden="true"></span>Why it exists
        </h2>
        <div class="flex max-w-[650px] flex-col gap-3 text-[14px] leading-relaxed text-muted">
          <p class="m-0">
            The right room bends your trajectory. The ambitious and the obsessed pull each other into
            motion, and the fastest way into that gravity is to go where it already exists: a residency,
            a hacker house, a co-living program built around serious peers.
          </p>
          <p class="m-0">
            0rbital keeps that landscape in one durable place: the live-in programs where founders,
            hackers, researchers, and creative technologists build around each other for a fixed term.
            Find your orbit, then build one of your own.
          </p>
        </div>
      </div>

      <aside class="rounded-[3px] border border-line bg-[rgba(16,16,16,.55)] p-6">
        <h2 class="m-0 mb-3 font-display text-[18px] font-bold text-text">What belongs here</h2>
        <ul class="orbit-list m-0 flex flex-col gap-2 text-[13px] leading-relaxed text-muted">
          <li>Founder residencies and relocation cohorts with a live-in component.</li>
          <li>Hacker houses and co-living programs organized around a builder scene.</li>
          <li>Programs with enough public information to compare location, format, housing, cost, funding, and application path.</li>
        </ul>
      </aside>
    </section>

    <div class="mx-auto max-w-[1100px] px-7"><hr class="orbit-divider" /></div>

    <section class="mx-auto max-w-[1100px] px-7 py-9">
      <h2 class="m-0 mb-3 flex items-center gap-2 font-display text-[19px] font-bold text-text">
        <span class="orbit-node" aria-hidden="true"></span>How to read 0rbital
      </h2>
      <div class="flex max-w-[720px] flex-col gap-3 text-[14px] leading-relaxed text-muted">
        <p class="m-0">
          Use the globe to feel where communities cluster, then open the list when you need a
          searchable, URL-addressable reference. Each record is meant to help you compare possible
          orbits without pretending that a dataset can replace your own due diligence.
        </p>
        <p class="m-0">
          0rbital currently tracks {PROGRAMS.length} live-in builder programs across {countryCount} countries.
          Missing facts are left unknown rather than invented, and public application details can change at any time.
          Always confirm terms on the official program site before applying.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="/"
          class="rounded-[3px] border border-transparent px-5 py-3 font-display text-[13.5px] font-bold text-[#0a0a0a] no-underline"
          style="background:var(--grad)"
        >
          Explore the globe
        </a>
        <a
          href="/explore"
          class="rounded-[3px] border border-line2 px-5 py-3 font-display text-[13px] font-semibold text-text no-underline transition hover:border-a1"
        >
          Browse the list
        </a>
      </div>
    </section>

    <section class="mx-auto max-w-[1100px] px-7 pb-16 pt-2">
      <div class="rounded-[3px] border border-line bg-[rgba(16,16,16,.55)] p-6">
        <h2 class="m-0 mb-2 font-display text-[18px] font-bold text-text">For contributors, agents, and external references</h2>
        <p class="m-0 mb-4 max-w-[720px] text-[13px] leading-relaxed text-muted">
          This page gives /story a stable purpose even when the main navigation opens the Story overlay:
          it documents the scope, language, and intent of 0rbital for search engines, screen readers,
          link previews, and machine-facing surfaces such as <a href="/llms.txt" class="font-semibold">/llms.txt</a>.
          Structured data is available at <a href="/api/programs.json" class="font-semibold">/api/programs.json</a>
          and <a href="/api/countries.json" class="font-semibold">/api/countries.json</a>.
        </p>
        <a
          href="/submit"
          class="inline-block rounded-[3px] border border-line2 px-4 py-2.5 font-display text-[13px] font-semibold text-text no-underline transition hover:border-a1"
        >
          Submit or update a program →
        </a>
      </div>
    </section>
  </main>
</Base>
