---
// Fonts are self-hosted (bundled from @fontsource) so the site has no
// third-party runtime dependency and renders identically offline/locally.
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import IntroOverlay from '../components/IntroOverlay.tsx';
import CountryDetailDrawer from '../components/CountryDetailDrawer.tsx';
import ApplyTrackPrompt from '../components/ApplyTrackPrompt.tsx';

interface Props {
  title: string;
  description?: string;
  /** Hide overflow + lock height for the full-screen map/globe pages. */
  fullscreen?: boolean;
}

const { title, description, fullscreen = false } = Astro.props;

// The intro overlay auto-opens only on the globe entry route, after the globe
// island marks its boot surface ready. Other pages can still open Story manually.
const autoIntro = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/orbital-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/orbital-mark.svg" />
    {description && <meta name="description" content={description} />}
    <slot name="head" />
  </head>
  <body class={fullscreen ? 'h-screen overflow-hidden' : 'min-h-screen'}>
    <slot />
    <IntroOverlay autoOpen={autoIntro} client:load />
    <CountryDetailDrawer client:load />
    {/* Compare (CompareTray/CompareDrawer + CompareButton) is built but disabled
        until per-program data is dense enough to compare — most founder-schema
        fields are still unfilled, so a side-by-side table would be mostly
        "Unknown". The components/stores/tests remain in the repo; re-mount the
        tray + drawer here and restore the CompareButtons to switch it back on. */}
    <ApplyTrackPrompt client:load />
  </body>
</html>
